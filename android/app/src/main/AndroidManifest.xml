<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Geofencing + tracking adattivo della posizione in background -->

        <service
            android:name=".location.LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <receiver
            android:name=".location.GeofenceBroadcastReceiver"
            android:exported="true" />

        <receiver
            android:name=".location.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Serve alle registrazioni audio (note vocali, riunioni) che usano
         navigator.mediaDevices.getUserMedia dentro la WebView: senza questo
         permesso dichiarato, Capacitor non può mai concederlo in runtime e
         getUserMedia fallisce sempre, silenziosamente. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 2026-09-02: trovato con adb logcat sul dispositivo di test — senza
         questo permesso il motore audio di Chromium (dentro la WebView)
         non riesce a selezionare il microfono come dispositivo di
         registrazione ("Unable to select communication device"), anche
         con RECORD_AUDIO gia' concesso e la richiesta permesso della
         WebView andata a buon fine. E' un permesso "normal" (nessun
         interruttore in Impostazioni, va solo dichiarato qui). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
