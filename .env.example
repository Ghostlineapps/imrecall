# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Stripe — Price ID dei tre piani (letti solo server-side, vedi
# src/lib/stripe/client.ts: il client manda "monthly"/"annual"/"founder" a
# /api/checkout, mai il Price ID direttamente, quindi nessuna di queste
# variabili ha bisogno del prefisso NEXT_PUBLIC_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDER=

# Attiva i limiti di piano (memorie/mese, minuti di trascrizione/mese,
# documenti/mese — vedi src/lib/subscription/limits.ts). Con qualsiasi
# valore diverso da "true" (incluso vuoto/assente), nessun limite di
# business scatta mai: comodo in fase di test, da mettere a "true" su
# Vercel al lancio vero, senza toccare il codice.
SUBSCRIPTION_LIMITS_ENABLED=

# Cron secret generico — protegge /api/cron/insights e
# /api/admin/founder-welcome.
CRON_SECRET=

# Cron secret dedicati, uno per ciascun job schedulato (vedi i rispettivi
# file in src/app/api/cron/*).
APPOINTMENT_CRON_SECRET=
DAILY_CAPTURE_REMINDER_CRON_SECRET=
GMAIL_CRON_SECRET=
MEDICATION_CRON_SECRET=
OUTLOOK_CRON_SECRET=

# Google — OAuth per collegare Gmail (Impostazioni → Integrazioni), vedi
# src/lib/google/client.ts. GOOGLE_TOKEN_ENCRYPTION_KEY cifra i token di
# accesso salvati nel database (vedi src/lib/google/tokenCrypto.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Microsoft — OAuth per collegare Outlook (Impostazioni → Integrazioni),
# vedi src/lib/microsoft/client.ts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Notifiche push (Web Push / VAPID) — vedi src/lib/push/server.ts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Resend — invio delle email di promemoria (vedi src/lib/email/resend.ts).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_APP_URL=https://imrecall.app
