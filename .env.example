# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Geocoding (per resurfacing spaziale — es. Google Geocoding API o Mapbox)
GEOCODING_API_KEY=

# Stripe — Price ID dei tre piani (letti solo server-side, vedi
# src/lib/stripe/client.ts: il client manda "monthly"/"annual"/"founder" a
# /api/checkout, mai il Price ID direttamente, quindi nessuna di queste
# variabili ha bisogno del prefisso NEXT_PUBLIC_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDER=

# Cron secret (per proteggere /api/cron/*)
CRON_SECRET=

NEXT_PUBLIC_APP_URL=https://imrecall.app
